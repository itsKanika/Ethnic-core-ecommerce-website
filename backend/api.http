### =================================================================
### ⚙️ GLOBAL CONFIGURATION (Bas yahan ek baar data badlo)
### =================================================================
@baseUrl = http://localhost:8000/api
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjZhM2VjNDFkM2QyYmY1NDY2YjUzYTBlNiIsImlhdCI6MTc4MjUwMDkxMCwiZXhwIjoxNzg1MDkyOTEwfQ.5gDNGtUF6kmHPPdL2g6AcVrSgNRzcMQndGfmcPwPFTU

### =================================================================
### 🛍️ STEP 1: CREATE A PRODUCT
### =================================================================
# Is request ko hit karte hi data direct MongoDB ke 'products' collection me jayega!
POST {{baseUrl}}/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Testing Designer wear Kurti",
    "description": "Inserting product to check mongo connection",
    "price": 1200,
    "category": "Clothing",
    "stock": 40,
    "imageUrl": "https://example.com/kurti.jpg"
}


### =================================================================
### 📦 STEP 2: CREATE AN ORDER
### =================================================================
# Is request ko hit karte hi data direct MongoDB ke 'orders' collection me jayega!
POST {{baseUrl}}/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "items": [
        {
            "product": "6a3ed4f922289b13a3f12e8f", 
            "qty": 1,
            "price": 1200
        }
    ],
    "totalAmount": 1200,
    "address": {
        "fullName": "Kanika Gupta",
        "street": "Vikas Marg",
        "city": "Delhi",
        "postalCode": "110092",
        "country": "India"
    },
    "paymentId": "pay_test_123"
}


### =================================================================
### 🚚 STEP 3: GET MY ORDERS
### =================================================================
# Yeh check karne k liye ki aapka order database se wapas aa raha h ya nahi
GET {{baseUrl}}/orders/myorders
Authorization: Bearer {{token}}
Content-Type: application/json


# B. Get Store Analytics

 GET {{baseUrl}}/analytics
 Authorization: Bearer {{token}}
